<resources>
    <string name="safe_area_title">外屏安全区</string>
    <string name="safe_area_description">统一调整助手各界面的布局与触摸范围。白条偏高、留白过大或内容靠边时，可按方向手动校准。真实缺口始终避开。</string>
    <string name="safe_area_direction">选择需要设置的方向</string>
    <string name="safe_area_auto">自动</string>
    <string name="safe_area_manual">手动</string>
    <string name="safe_area_auto_help">自动：根据屏幕、缺口与系统边衬计算。切回自动会保留手动参数。</string>
    <string name="safe_area_manual_help">手动：使用当前方向的校准边界，其他方向不受影响。不会关闭系统 Home 或返回手势。</string>
    <string name="safe_area_guides">显示安全区辅助线</string>
    <string name="safe_area_guides_help">在外屏描出当前生效边界，不影响触摸。调整时自动显示，退出后恢复此开关的选择。</string>
    <string name="safe_area_begin">开始调整</string>
    <string name="safe_area_switch_title">切换外屏方向？</string>
    <string name="safe_area_switch_message">调整 %1$d° 安全区需要将外屏临时旋转至 %1$d°。结束调整后，将恢复之前的旋转设置。</string>
    <string name="safe_area_lock_title">开始安全区校准？</string>
    <string name="safe_area_lock_message">校准期间将临时锁定外屏方向，避免调整时发生旋转。结束后恢复之前的旋转设置。</string>
    <string name="safe_area_continue">继续</string>
    <string name="safe_area_save">保存安全区</string>
    <string name="safe_area_cancel">取消调整</string>
    <string name="safe_area_fill">用当前自动值填入</string>
    <string name="safe_area_edit_help">青色描边是可用轮廓，正在调整的边为黄色。数值是距屏幕边缘的布局像素，不是照片像素。调整时实时试用，保存后保留，取消恢复。</string>
    <string name="safe_area_preview">布局示意 · 以外屏实际描边为准</string>
    <string name="safe_area_dimensions">当前方向 %1$d° · 校准尺寸 %2$d × %3$d px</string>
    <string name="safe_area_left">左边界</string>
    <string name="safe_area_top">上边界</string>
    <string name="safe_area_right">右边界</string>
    <string name="safe_area_bottom">下边界</string>
    <string name="safe_area_reset_one">重置本方向</string>
    <string name="safe_area_reset_all">全部重置</string>
    <string name="safe_area_reset_one_help">清除 %1$d° 的手动参数并恢复自动，其他方向不变。</string>
    <string name="safe_area_reset_all_help">清除四个方向的手动参数并全部恢复自动。</string>
    <string name="safe_area_reset_action">重置</string>
    <string name="safe_area_recover_rotation">重试恢复原旋转设置</string>
    <string name="safe_area_unavailable">请先开启助手并点亮所选外屏。校准需要 Shizuku 连接，以临时切换并恢复旋转设置。</string>
    <string name="safe_area_mismatch">外屏或校准尺寸已改变，暂时使用自动模式。原手动参数已保留，请重新校准。</string>
    <string name="safe_area_other_direction">当前外屏为 %1$d°。可以查看此方向的配置，开始调整时会提示切换方向。</string>
    <string name="safe_area_invalid">调整范围过大，请保留足够的可用区域。</string>
    <string name="safe_area_save_failed">未能保存，请重试；原设置仍保留。</string>
    <string name="safe_area_discard_title">放弃安全区调整？</string>
    <string name="safe_area_discard_help">尚未保存的边界不会保留，并恢复校准前的旋转设置。</string>
    <string name="safe_area_discard">放弃调整</string>
    <string name="safe_area_device_local">校准仅用于本机所选外屏，不随配置文件导入或导出。换屏或布局尺寸改变后需重新校准。</string>
</resources>
